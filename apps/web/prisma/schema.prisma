generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  projects    Project[]
}

model Project {
  id             String         @id @default(uuid())
  name           String
  description    String?
  status         String         @default("Planned")
  workspaceId    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  activities     Activity[]
  decisions      Decision[]
  documents      Document[]
  finance        Finance?
  journalEntries JournalEntry[]
  meetings       Meeting[]
  milestones     Milestone[]
  people         Person[]
  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  risks          Risk[]
  tasks          Task[]
  quotations     Quotation[]
}

model BusinessClient {
  id          String      @id @default(uuid())
  company     String
  contactName String?
  address     String?
  vatTin      String?
  email       String?
  phone       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  quotations  Quotation[]
}

model CatalogueItem {
  id          String          @id @default(uuid())
  code        String          @unique
  description String
  unitPrice   Float           @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lines       QuotationLine[]
}

model Quotation {
  id             String              @id @default(uuid())
  quotationNo    String              @unique
  quotationDate  DateTime            @default(now())
  validDays      Int                 @default(30)
  projectRef     String?
  jobDescription String
  currency       String              @default("USD")
  vatRate        Float               @default(0)
  status         String              @default("DRAFT")
  revision       Int                 @default(0)
  clientId       String
  projectId      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  client         BusinessClient      @relation(fields: [clientId], references: [id])
  project        Project?            @relation(fields: [projectId], references: [id])
  lines          QuotationLine[]
  revisions      QuotationRevision[]
}

model QuotationRevision {
  id          String    @id @default(uuid())
  revision    Int
  snapshot    Json
  quotationId String
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, revision])
  @@index([quotationId, createdAt])
}

model QuotationLine {
  id              String         @id @default(uuid())
  position        Int
  itemCode        String
  description     String
  quantity        Float          @default(1)
  days            Float          @default(1)
  unitPrice       Float          @default(0)
  quotationId     String
  catalogueItemId String?
  quotation       Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id])

  @@index([quotationId, position])
}

model Person {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  email     String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  company   String?
  phone     String?
  projectId String?
  role      String?
  project   Project?  @relation(fields: [projectId], references: [id])
}

model Task {
  id              String          @id @default(uuid())
  title           String
  projectId       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  description     String?
  dueDate         DateTime?
  scheduledAt     DateTime?
  durationMinutes Int             @default(60)
  priority        Int             @default(3)
  status          TaskStatus      @default(TODO)
  project         Project         @relation(fields: [projectId], references: [id])
  dailyPlanItems  DailyPlanItem[]
}

model DailyPlan {
  id        String          @id @default(uuid())
  planDate  DateTime        @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     DailyPlanItem[]
  notes     DailyPlanNote[]
}

model DailyPlanItem {
  id          String    @id @default(uuid())
  position    Int       @default(0)
  dailyPlanId String
  taskId      String
  dailyPlan   DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([dailyPlanId, taskId])
  @@index([dailyPlanId, position])
}

model DailyPlanNote {
  id             String       @id @default(uuid())
  dailyPlanId    String
  journalEntryId String
  dailyPlan      DailyPlan    @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@unique([dailyPlanId, journalEntryId])
}

model Meeting {
  id            String            @id @default(uuid())
  title         String
  meetingDate   DateTime
  projectId     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  description   String?
  location      String?
  status        MeetingStatus     @default(SCHEDULED)
  googleEventId String?           @unique
  project       Project?          @relation(fields: [projectId], references: [id])
  reminders     MeetingReminder[]
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingReminder {
  id           String    @id @default(uuid())
  meetingId    String    @unique
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Document {
  id          String   @id @default(uuid())
  name        String
  fileName    String
  fileType    String
  fileSize    Int
  description String?
  driveFileId String?  @unique
  webViewLink String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id])
}

model GoogleDriveConnection {
  id           String   @id @default("default")
  refreshToken String
  folderId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InboxItem {
  id        String   @id @default(uuid())
  content   String
  source    String   @default("Manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String?
  projectId   String?
  createdAt   DateTime @default(now())
  project     Project? @relation(fields: [projectId], references: [id])
}

model Decision {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("Proposed")
  owner       String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id])
}

model Risk {
  id          String   @id @default(uuid())
  title       String
  description String?
  probability Int      @default(3)
  impact      Int      @default(3)
  owner       String?
  mitigation  String?
  status      String   @default("Open")
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id])
}

model Milestone {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("Planned")
  completedAt DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id])
}

model Finance {
  id             String   @id @default(uuid())
  approvedBudget Float    @default(0)
  forecastCost   Float    @default(0)
  actualCost     Float    @default(0)
  contingency    Float    @default(0)
  currency       String   @default("USD")
  projectId      String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id])
}

model JournalEntry {
  id             String          @id @default(uuid())
  title          String
  content        String
  category       String          @default("General")
  projectId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id])
  dailyPlanNotes DailyPlanNote[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETE
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
